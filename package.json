{
  "name": "gourwest-ordering-simulator",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Gourwest ordering website (demo simulator) that posts signed orders into Luminara CRM.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/csp.mjs",
    "preview": "npm run build && wrangler pages dev dist --port 8788",
    "check": "astro check && tsc -p functions/tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "npm run check && npm test && npm run build",
    "globe:points": "node scripts/build-globe-points.mjs",
    "deploy": "npm run verify && wrangler pages deploy dist"
  },
  "dependencies": {
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "astro": "7.4.12",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/sitemap": "3.7.5",
    "@cloudflare/workers-types": "5.20261124.2",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "lucide-static": "1.74.0",
    "topojson-client": "3.1.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "world-atlas": "2.0.2",
    "wrangler": "4.168.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261117.1": true
  }
}
