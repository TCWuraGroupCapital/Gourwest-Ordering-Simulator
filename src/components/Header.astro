---
import Icon from './Icon.astro';
import { STORES } from '../data/stores';

const NAV = [
  { href: '/menu/', label: 'Menu' },
  { href: '/our-story/', label: 'Our Story' },
  { href: '/locations/', label: 'Locations' },
  { href: '/rewards/', label: 'Rewards' },
  { href: '/catering/', label: 'Catering' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="strip">
    <div class="wrap strip__inner">
      <span class="strip__store">
        <Icon name="map-pin" size={16} />
        <span>Pickup from <strong data-store-name>{STORES[0].name}</strong> · ready in about <span data-store-prep>15</span> min</span>
      </span>
      <button class="strip__change" type="button" popovertarget="store-picker">Change kitchen</button>
    </div>
  </div>

  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Gourwest home">
      <img src="/brand/gourwest-mark.webp" width="40" height="40" alt="" />
      <span class="brand__words">
        <span class="brand__name">Gour<span>west</span></span>
        <span class="brand__tag">Flavours united. Worldwide.</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main">
      {
        NAV.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Switch colour theme">
        <Icon name="moon" class="i-moon" />
        <Icon name="sun" class="i-sun" />
      </button>
      <a class="track-pill" href="/order/confirmed/" hidden data-track-pill>
        <Icon name="clock" size={18} />
        <span class="num" data-track-text></span>
      </a>
      <a class="bag" href="/cart/" aria-label="Your bag">
        <Icon name="shopping-bag" />
        <span class="bag__count num" data-cart-count>0</span>
        <span class="bag__total num" data-cart-total>$0.00</span>
      </a>
      <a class="btn order-cta" href="/menu/">Order online</a>
      <button class="icon-btn menu-toggle" type="button" popovertarget="mobile-nav" aria-label="Open menu">
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <div id="mobile-nav" popover class="mobile-nav">
    <div class="mobile-nav__head">
      <span class="label">Navigate</span>
      <button class="icon-btn" type="button" popovertarget="mobile-nav" popovertargetaction="hide" aria-label="Close menu">
        <Icon name="x" />
      </button>
    </div>
    <nav aria-label="Mobile">
      {
        NAV.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
            <Icon name="arrow-right" size={18} />
          </a>
        ))
      }
      <a href="/contact/">Contact <Icon name="arrow-right" size={18} /></a>
    </nav>
    <a class="btn btn--lg btn--block" href="/menu/">Start your order</a>
  </div>

  <div id="store-picker" popover class="store-picker" aria-labelledby="store-picker-title">
    <div class="mobile-nav__head">
      <h2 id="store-picker-title">Choose your kitchen</h2>
      <button class="icon-btn" type="button" popovertarget="store-picker" popovertargetaction="hide" aria-label="Close">
        <Icon name="x" />
      </button>
    </div>
    <ul class="store-list" role="list">
      {
        STORES.map((store) => (
          <li>
            <button class="store-option" type="button" data-store-option={store.id}>
              <span>
                <strong>{store.name}</strong>
                <span class="small muted">{store.city}, {store.country}</span>
              </span>
              <span class="store-option__open small" data-open-badge={store.id} />
            </button>
          </li>
        ))
      }
    </ul>
    <a class="link-arrow" href="/locations/">See the map and opening hours <Icon name="arrow-right" /></a>
  </div>
</header>

<script>
  import { cartSummary, getStore, lastOrder, setStore, EVENT } from '../scripts/state';
  import { formatAUD } from '../lib/pricing';
  import { trackOrder } from '../lib/tracking';

  function render() {
    const { count, subtotal } = cartSummary();
    const store = getStore();
    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((el) => (el.textContent = String(count)));
    document.querySelectorAll<HTMLElement>('[data-cart-total]').forEach((el) => (el.textContent = formatAUD(subtotal)));
    document.querySelectorAll<HTMLElement>('[data-store-name]').forEach((el) => (el.textContent = store.name));
    document.querySelectorAll<HTMLElement>('[data-store-prep]').forEach((el) => (el.textContent = String(store.prepMinutes)));
    document.querySelectorAll<HTMLButtonElement>('[data-store-option]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.storeOption === store.id));
    });
    const bag = document.querySelector('.bag');
    bag?.setAttribute('aria-label', `Your bag: ${count} item${count === 1 ? '' : 's'}, ${formatAUD(subtotal)}`);
    renderTracker();
  }

  // An order in progress follows you around the site until it is collected.
  function renderTracker() {
    const pill = document.querySelector<HTMLAnchorElement>('[data-track-pill]');
    if (!pill) return;
    const order = lastOrder();
    const t = order && trackOrder(order.placedAt, order.store.prepMinutes);
    pill.hidden = !t?.active;
    if (!t?.active) return;
    const ready = t.ready;
    pill.dataset.ready = String(ready);
    pill.querySelector('[data-track-text]')!.textContent = ready ? 'Ready' : `${t.minutesLeft} min`;
    pill.setAttribute('aria-label', ready ? 'Your order is ready to collect' : `Your order: ready in about ${t.minutesLeft} minutes`);
  }
  setInterval(renderTracker, 30_000);

  document.addEventListener('click', (event) => {
    const option = (event.target as Element).closest<HTMLButtonElement>('[data-store-option]');
    if (!option) return;
    setStore(option.dataset.storeOption!);
    document.getElementById('store-picker')?.hidePopover();
  });

  const root = document.documentElement;
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    root.dataset.theme = dark ? 'light' : 'dark';
    try {
      localStorage.setItem('gourwest:theme', root.dataset.theme);
    } catch {}
  });

  window.addEventListener(EVENT, render);
  render();

  // Once you scroll, the kitchen strip slides away so sticky bars give the screen back to the food.
  // The strip's height is measured, not assumed, because it wraps at large text sizes.
  const strip = document.querySelector<HTMLElement>('.strip')!;
  const measure = () => root.style.setProperty('--strip-h', `${strip.offsetHeight}px`);
  const condense = () => root.classList.toggle('is-condensed', window.scrollY > 120);
  measure();
  condense();
  window.addEventListener('resize', measure);
  window.addEventListener('scroll', condense, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    view-transition-name: site-header;
    background: color-mix(in oklch, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  /* Sticky bars that sit under the header move with it when the strip slides away. */
  .site-header,
  :global(.follows-header) {
    transition: translate var(--t-ui) var(--ease-out);
  }
  :global(html.is-condensed) .site-header,
  :global(html.is-condensed .follows-header) {
    translate: 0 calc(-1 * var(--strip-h, 44px));
  }
  /* Never hide a focused "Change kitchen" off-screen. */
  :global(html.is-condensed) .site-header:has(.strip :focus-visible) {
    translate: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header,
    :global(.follows-header) {
      transition: none;
    }
  }
  /* The strip stays deep forest in both themes, so its colours are fixed rather than themed. */
  .strip {
    background: oklch(0.246 0.049 170);
    color: oklch(0.97 0.01 90);
    font-size: var(--step--1);
  }
  .strip :focus-visible {
    outline-color: oklch(0.73 0.1 84);
  }
  .strip__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    min-height: 44px;
  }
  .strip__store {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-width: 0;
  }
  .strip__store svg {
    flex: none;
    color: var(--gold-bright);
  }
  .strip__store > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .strip__change {
    flex: none;
    min-height: 44px;
    padding: 0 var(--s-2);
    border: 0;
    background: none;
    color: oklch(0.80 0.10 84);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 44px;
    text-decoration: none;
    flex: none;
  }
  .brand img {
    width: 40px;
    height: 40px;
  }
  .brand__words {
    display: grid;
    line-height: 1.1;
  }
  .brand__name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--forest-deep);
  }
  .brand__name span {
    color: var(--gold);
  }
  .brand__tag {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--fg-2);
  }
  .nav {
    display: none;
    gap: var(--s-1);
  }
  .nav a {
    position: relative;
    padding: var(--s-3) var(--s-3);
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--fg-2);
    text-decoration: none;
    border-radius: var(--r-1);
    transition: color var(--t-micro) var(--ease-out);
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--forest-deep);
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: var(--s-3);
    right: var(--s-3);
    bottom: 6px;
    height: 2px;
    background: var(--gold-bright);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-ui) var(--ease-out);
  }
  .nav a:hover::after,
  .nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
  .bag {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    padding: 0 var(--s-3);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--surface);
    color: var(--forest);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--step--1);
  }
  .bag:hover {
    background: var(--surface-2);
  }
  .track-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    padding: 0 var(--s-3);
    border-radius: var(--r-pill);
    background: var(--forest);
    color: var(--on-forest);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--step--1);
  }
  .track-pill[hidden] {
    display: none;
  }
  .track-pill[data-ready='true'] {
    background: var(--ok);
  }
  .track-pill:hover {
    background: var(--forest-deep);
  }
  /* Phones: make room for the pill by dropping the wordmark next to the logo. */
  @media (max-width: 479px) {
    .site-header:has(.track-pill:not([hidden])) .brand__words {
      display: none;
    }
  }
  .bag__count {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: var(--r-pill);
    background: var(--terracotta);
    color: var(--on-terracotta);
    font-size: 0.75rem;
  }
  .bag__total,
  .order-cta,
  .theme-toggle {
    display: none;
  }
  .theme-toggle :global(.i-sun) {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle :global(.i-moon) {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle :global(.i-sun) {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle :global(.i-moon) {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .theme-toggle :global(.i-sun) {
      display: block;
    }
  }
  @media (min-width: 640px) {
    .bag__total,
    .theme-toggle {
      display: inline-flex;
    }
  }
  @media (min-width: 1100px) {
    .nav,
    .order-cta {
      display: flex;
    }
    .menu-toggle {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .brand__tag {
      display: none;
    }
  }

  .mobile-nav,
  .store-picker {
    inset: 0 0 auto auto;
    width: min(26rem, 100vw);
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: var(--s-5);
    border: 0;
    border-left: 1px solid var(--line);
    background: var(--bg);
    color: var(--fg);
    box-shadow: var(--shadow-3);
    overflow-y: auto;
    transition: transform var(--t-ui) var(--ease-out), opacity var(--t-ui) var(--ease-out), overlay var(--t-ui) allow-discrete, display var(--t-ui) allow-discrete;
    transform: translateX(24px);
    opacity: 0;
  }
  .mobile-nav:popover-open,
  .store-picker:popover-open {
    display: grid;
    align-content: start;
    gap: var(--s-5);
    transform: none;
    opacity: 1;
  }
  @starting-style {
    .mobile-nav:popover-open,
    .store-picker:popover-open {
      transform: translateX(24px);
      opacity: 0;
    }
  }
  .mobile-nav::backdrop,
  .store-picker::backdrop {
    background: oklch(0.2 0.03 168 / 0.4);
  }
  .mobile-nav__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }
  .mobile-nav__head h2 {
    font-size: var(--step-2);
  }
  .mobile-nav nav {
    display: grid;
  }
  .mobile-nav nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--forest-deep);
    text-decoration: none;
  }
  .store-list {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .store-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    width: 100%;
    min-height: 64px;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-1);
    background: var(--surface);
    text-align: left;
    cursor: pointer;
  }
  .store-option > span:first-child {
    display: grid;
  }
  .store-option:hover {
    border-color: var(--line-strong);
  }
  .store-option[aria-pressed='true'] {
    border-color: var(--forest);
    box-shadow: inset 0 0 0 1px var(--forest);
  }
  .store-option__open {
    font-weight: 700;
    white-space: nowrap;
  }
  .store-option__open[data-state='open'] {
    color: var(--ok);
  }
  .store-option__open[data-state='closed'] {
    color: var(--fg-3);
  }
</style>
