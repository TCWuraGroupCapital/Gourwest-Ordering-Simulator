---
interface Props {
  label: string;
  title: string;
  lead?: string;
}
const { label, title, lead } = Astro.props;
---

<header class="intro">
  <div class="wrap intro__inner">
    <p class="label">{label}</p>
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .intro {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 2.5rem);
  }
  .intro__inner {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }
  .intro__inner > :global(*) {
    max-width: 44rem;
  }
  .lead {
    max-width: 34em;
  }
</style>
