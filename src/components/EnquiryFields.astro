---
/** Name, email, phone, message, consent and the bot check — the fields every enquiry form shares. */
import Turnstile from './Turnstile.astro';

interface Props {
  messageLabel: string;
  messagePlaceholder: string;
}
const { messageLabel, messagePlaceholder } = Astro.props;
---

<div class="field">
  <label for="enq-name">Your name</label>
  <input id="enq-name" class="input" name="name" autocomplete="name" maxlength="80" required aria-describedby="enq-name-error" />
  <p class="error" id="enq-name-error" data-error-for="name" hidden></p>
</div>
<div class="field">
  <label for="enq-email">Email</label>
  <input id="enq-email" class="input" name="email" type="email" autocomplete="email" maxlength="254" required aria-describedby="enq-email-error" />
  <p class="error" id="enq-email-error" data-error-for="email" hidden></p>
</div>
<div class="field">
  <label for="enq-phone">Phone <span class="muted">(optional)</span></label>
  <input id="enq-phone" class="input" name="phone" type="tel" autocomplete="tel" maxlength="24" aria-describedby="enq-phone-error" />
  <p class="error" id="enq-phone-error" data-error-for="phone" hidden></p>
</div>
<slot />
<div class="field span-all">
  <label for="enq-message">{messageLabel}</label>
  <textarea id="enq-message" class="textarea" name="message" maxlength="2000" rows="5" required placeholder={messagePlaceholder} aria-describedby="enq-message-error"></textarea>
  <p class="error" id="enq-message-error" data-error-for="message" hidden></p>
</div>
<div class="hp" aria-hidden="true">
  <label for="enq-website">Leave this empty</label>
  <input id="enq-website" name="website" tabindex="-1" autocomplete="off" />
</div>
<div class="span-all">
  <label class="check">
    <input type="checkbox" name="consent" value="yes" required />
    <span>I agree to Gourwest contacting me about this enquiry, as described in the <a href="/privacy/">privacy policy</a>.</span>
  </label>
  <p class="error small" data-error-for="consent" hidden></p>
</div>
<Turnstile />
<p class="notice notice--bad span-all" role="alert" data-status hidden></p>
