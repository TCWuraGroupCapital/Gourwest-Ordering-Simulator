---
/** Long-form reading column for policy pages. */
---

<div class="wrap">
  <div class="prose">
    <slot />
  </div>
</div>

<style>
  .prose {
    max-width: 40rem;
  }
  .prose :global(h2) {
    font-size: var(--step-2);
    margin-top: var(--s-7);
    margin-bottom: var(--s-3);
  }
  .prose :global(p),
  .prose :global(ul) {
    margin-bottom: var(--s-4);
    color: var(--fg-2);
  }
  .prose :global(li + li) {
    margin-top: var(--s-2);
  }
  .prose :global(strong) {
    color: var(--fg);
  }
</style>
