---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Globe from '../components/Globe.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import { HOURS_FAQ, KITCHENS_FAQ, PICKUP_FAQ, restaurantNode } from '../lib/seo';
import { STORES, formatHours } from '../data/stores';

const mapsUrl = (address: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`Gourwest ${address}`)}`;
---

<Base schema={STORES.map((s) => restaurantNode(s, Astro.site!))} title="Locations" description="Gourwest kitchens in Melbourne, Auckland, Singapore and Kuala Lumpur — addresses, opening hours and pickup times.">
  <PageIntro label="Kitchens" title="Five kitchens, four cities" lead="Choose a kitchen for pickup. Hours are local time; most orders are ready in about 15 minutes." />

  <div class="wrap locations">
    <div class="locations__globe">
      <Globe />
    </div>
    <ul class="stores" role="list">
      {
        STORES.map((s) => (
          <li class="store card" id={s.id} data-store-card={s.id}>
            <div class="store__top">
              <div>
                <p class="label">
                  {s.city}, {s.country}
                </p>
                <h2>{s.name}</h2>
              </div>
              <span class="store__status small" data-open-badge={s.id} />
            </div>
            <p class="store__line">
              <Icon name="map-pin" size={18} /> {s.address}
            </p>
            <p class="store__line num">
              <Icon name="clock" size={18} /> Daily {formatHours(s)} · ready in ~{s.prepMinutes} min
            </p>
            <div class="store__actions">
              <button class="btn" type="button" data-pick-store={s.id}>
                Order from {s.name}
              </button>
              <a class="btn btn--ghost" href={mapsUrl(s.address)} target="_blank" rel="noopener noreferrer">
                Directions <Icon name="external-link" size={16} />
                <span class="visually-hidden">(opens Google Maps in a new tab)</span>
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <Faq faqs={[PICKUP_FAQ, HOURS_FAQ, KITCHENS_FAQ]} tint />
</Base>

<script>
  import { EVENT, getStore } from '../scripts/state';

  const mark = () => {
    const id = getStore().id;
    document.querySelectorAll<HTMLElement>('[data-store-card]').forEach((card) => card.toggleAttribute('data-current', card.dataset.storeCard === id));
  };
  window.addEventListener(EVENT, mark);
  mark();
</script>

<style>
  .locations {
    display: grid;
    gap: var(--s-6);
    align-items: start;
  }
  @media (min-width: 1000px) {
    .locations {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
    .locations__globe {
      position: sticky;
      top: 140px;
    }
  }
  .stores {
    display: grid;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
  }
  .store {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-5);
    scroll-margin-top: 8rem;
    transition: box-shadow var(--t-ui) var(--ease-out), border-color var(--t-ui) var(--ease-out);
  }
  .store[data-current] {
    border-color: var(--forest);
    box-shadow: inset 0 0 0 1px var(--forest), var(--shadow-1);
  }
  .store__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-4);
  }
  .store h2 {
    font-size: var(--step-2);
  }
  .store__status {
    flex: none;
    padding: 0.2rem 0.7rem;
    border-radius: var(--r-pill);
    font-weight: 700;
    background: var(--surface-2);
  }
  .store__status[data-state='open'] {
    color: var(--ok);
    background: color-mix(in oklch, var(--ok) 12%, var(--surface));
  }
  .store__line {
    display: flex;
    gap: var(--s-2);
    align-items: flex-start;
    color: var(--fg-2);
  }
  .store__line :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--gold);
  }
  .store__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }
</style>
