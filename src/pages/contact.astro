---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import EnquiryFields from '../components/EnquiryFields.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import { CATERING_FAQ, HOURS_FAQ } from '../lib/seo';

const topics = [
  { value: 'order', label: 'A recent order' },
  { value: 'feedback', label: 'Feedback on a kitchen' },
  { value: 'allergens', label: 'Allergens and ingredients' },
  { value: 'privacy', label: 'Privacy or my data' },
  { value: 'other', label: 'Something else' },
];
const faqs = [
  { q: 'How quickly does Gourwest reply to messages?', a: 'Within one business day, by email. Each message gets a reference number once it is sent.' },
  { q: 'What should I do if I have a severe allergy?', a: 'Call the kitchen directly before you order rather than sending a message. Our kitchens handle every listed allergen, so no dish is certified allergen-free; the allergen guide lists what each standard recipe contains.' },
  HOURS_FAQ,
  CATERING_FAQ,
];
---

<Base title="Contact us" description="Questions about an order, allergens, feedback or your data? Send the Gourwest guest team a message.">
  <PageIntro label="Contact" title="We’d love to hear from you" lead="Our guest team answers every message within one business day." />

  <div class="wrap contact">
    <aside class="contact__side">
      <div class="panel">
        <Icon name="triangle-alert" size={22} />
        <h2>Severe allergy?</h2>
        <p class="muted">Please call the kitchen directly before you order, rather than using this form. Opening hours and addresses are on the <a href="/locations/">locations page</a>.</p>
      </div>
      <div class="panel">
        <Icon name="sparkles" size={22} />
        <h2>Quick menu question?</h2>
        <p class="muted">The concierge knows every dish, price and allergen.</p>
        <button class="btn btn--ghost" type="button" data-open-concierge="">Ask the concierge</button>
      </div>
    </aside>

    <div class="panel">
      <form class="form-grid" data-enquiry novalidate>
        <input type="hidden" name="kind" value="contact" />
        <EnquiryFields messageLabel="Your message" messagePlaceholder="Tell us what happened, which kitchen and when.">
          <div class="field">
            <label for="enq-topic">Topic</label>
            <select id="enq-topic" class="select" name="topic">
              {topics.map((t) => <option value={t.value}>{t.label}</option>)}
            </select>
          </div>
        </EnquiryFields>
        <button class="btn btn--lg span-all" type="submit">Send message</button>
      </form>
      <div class="done" hidden tabindex="-1" data-done>
        <Icon name="circle-check" size={32} />
        <h2>Message sent</h2>
        <p class="muted">Reference <strong class="num" data-ref></strong>. We’ll reply by email within one business day.</p>
      </div>
    </div>
  </div>
  <Faq faqs={faqs} tint />
</Base>

<script>
  import '../scripts/enquiry';
</script>

<style>
  .contact {
    display: grid;
    gap: var(--s-5);
    align-items: start;
  }
  @media (min-width: 960px) {
    .contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    }
  }
  .contact__side {
    display: grid;
    gap: var(--s-4);
  }
  .contact__side .panel {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
  }
  .contact__side h2 {
    font-size: var(--step-1);
  }
  .contact__side :global(svg) {
    color: var(--gold);
  }
</style>
